# Alfred - Personal AI Assistant with Persistent Memory
# Copy this file to .env and fill in your actual keys

# Anthropic API key (required)
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Mem0 API key (optional - uses local storage if not set)
# Get yours at https://app.mem0.ai/
MEM0_API_KEY=your_mem0_api_key_here

# User identifier for memory scoping (optional, defaults to "default_user")
ALFRED_USER_ID=your_name_here
